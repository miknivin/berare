# Supabase (from `supabase start` locally, or the hosted project dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google OAuth is configured once in the Supabase dashboard (Auth > Providers),
# not per-app — no Google client ID/secret needed here.

# Razorpay (test-mode keys for local dev)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Resend (transactional email — order confirmations)
RESEND_API_KEY=

# AWS S3 — reading product images (public-read bucket, uploaded via the
# admin app). Same values as admin's .env.local — no access key/secret
# needed here, the storefront only ever reads.
NEXT_PUBLIC_S3_BUCKET_NAME=
NEXT_PUBLIC_S3_REGION=
NEXT_PUBLIC_S3_PUBLIC_URL_BASE=

# App URLs — used to build shareable affiliate links and auth redirect URLs
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
NEXT_PUBLIC_AFFILIATE_URL=http://localhost:3002
