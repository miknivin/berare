# Supabase — admin app additionally needs the secret key.
# SUPABASE_SECRET_KEY must never be prefixed NEXT_PUBLIC_ and must
# never be referenced from a Client Component.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Resend (affiliate approval/rejection, withdrawal status emails)
RESEND_API_KEY=

# AWS S3 — product image storage (public-read bucket). Deliberately not
# named AWS_REGION/AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY — those are
# reserved on Vercel (its functions run on AWS Lambda, which injects its
# own values into exactly those names). Bucket name/region are NEXT_PUBLIC_
# because the storefront's client components need them too (to build
# <Image> src URLs) — they aren't secrets, only the access key/secret are.
#
# The bucket itself needs two things configured in the AWS Console, not here:
#  1. A bucket policy allowing public s3:GetObject (public-read images)
#  2. CORS allowing PUT from the admin app's origin (localhost:3001 in dev,
#     your real admin domain in production) — without this, the browser's
#     direct upload via presigned URL fails with a CORS error, not a
#     helpful S3 error message.
NEXT_PUBLIC_S3_BUCKET_NAME=
NEXT_PUBLIC_S3_REGION=
# Optional — only if fronting the bucket with CloudFront or a custom domain
NEXT_PUBLIC_S3_PUBLIC_URL_BASE=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# App URLs
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
NEXT_PUBLIC_AFFILIATE_URL=http://localhost:3002
