# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# App URLs — used for the apply link and generated affiliate links
# (NEXT_PUBLIC_AFFILIATE_URL isn't read by this app itself; the storefront
# reads it to link back here from its own /affiliate-apply page)
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
NEXT_PUBLIC_AFFILIATE_URL=http://localhost:3002

# Minimum confirmed points balance required before an affiliate can request
# a withdrawal. Keep in sync with app_config.min_withdrawal_amount, which is
# the value actually enforced at the database layer.
MIN_WITHDRAWAL_POINTS=2000
